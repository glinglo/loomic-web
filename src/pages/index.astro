---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import BlogCard from '../components/BlogCard.astro';
import CTA from '../components/CTA.astro';
import apps from '../data/apps.json';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const recentPosts = blogPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Loomic',
  url: 'https://loomic.com',
  logo: 'https://loomic.com/favicon.svg',
  description: 'Shopify apps that help you sell more. We build tools that turn your store data into revenue.',
  sameAs: [],
};

const whyLoomicItems = [
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />',
    title: 'Built for Shopify',
    description: 'Embedded directly in your admin. No external dashboards, no context switching.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />',
    title: 'Data-driven',
    description: 'Analytics-first approach. We turn your order data into actionable insights.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
    title: 'Fair pricing',
    description: 'Transparent, usage-based pricing. No enterprise markups or hidden fees.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
    title: 'Real support',
    description: 'We answer every message. Real humans, real help, usually within hours.',
  },
];
---

<BaseLayout
  title="Loomic - Shopify Apps That Help You Sell More"
  description="We build Shopify apps that turn your store data into revenue. Analytics-first tools for retention, profitability, and growth."
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Gradient decoration -->
    <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/4 w-[600px] h-[600px] bg-gradient-to-br from-primary-500/20 to-secondary-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/4 w-[400px] h-[400px] bg-gradient-to-tr from-secondary-500/10 to-primary-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom section-padding relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
          Shopify apps that help you
          <span class="gradient-text">sell more</span>
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 mb-10 max-w-2xl mx-auto">
          We build tools that turn your store data into revenue.
        </p>

        <a href="#apps" class="btn-primary">
          Explore our apps
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Apps Showcase -->
  <section id="apps" class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Our Apps
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Purpose-built tools for Shopify merchants who want to grow smarter.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {apps.map((app) => (
          <AppCard
            name={app.name}
            slug={app.slug}
            tagline={app.tagline}
            icon={app.icon}
            status={app.status}
            color={app.color}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Loomic -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Why Loomic?
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We're not just another app developer. We build tools the way we'd want them built.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto">
        {whyLoomicItems.map((item) => (
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 text-white mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest from Blog -->
  {recentPosts.length > 0 && (
    <section class="section-padding bg-gray-50">
      <div class="container-custom">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
              Latest from the Blog
            </h2>
            <p class="text-lg text-gray-600">
              Insights on retention, profitability, and DTC strategy.
            </p>
          </div>
          <a href="/blog" class="text-primary-500 font-medium hover:text-primary-600 transition-colors">
            View all posts →
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              slug={post.id}
              date={post.data.date}
              category={post.data.category}
              excerpt={post.data.excerpt}
              image={post.data.image}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <CTA
    title="Ready to grow your store?"
    description="Start with our free apps and upgrade when you're ready."
    buttonText="Explore our apps"
    buttonHref="#apps"
    variant="gradient"
  />
</BaseLayout>
