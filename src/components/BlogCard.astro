---
interface Props {
  title: string;
  slug: string;
  date: Date;
  category: string;
  excerpt: string;
  image?: string;
  readingTime?: number;
}

const { title, slug, date, category, excerpt, image, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  'Customer Retention': 'bg-rose-50 text-rose-600',
  'Profitability': 'bg-emerald-50 text-emerald-600',
  'Shopify Tips': 'bg-blue-50 text-blue-600',
  'DTC Strategy': 'bg-purple-50 text-purple-600',
};

const categoryColor = categoryColors[category] || 'bg-gray-100 text-gray-600';
---

<a
  href={`/blog/${slug}`}
  class="group block bg-white rounded-xl border border-gray-100 overflow-hidden transition-all duration-200 hover:border-gray-200 hover:shadow-lg"
>
  {image && (
    <div class="aspect-[16/9] overflow-hidden bg-gray-100">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${categoryColor}`}>
        {category}
      </span>
      <span class="text-xs text-gray-400">{formattedDate}</span>
      {readingTime && (
        <>
          <span class="text-gray-300">·</span>
          <span class="text-xs text-gray-400">{readingTime} min read</span>
        </>
      )}
    </div>

    <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-primary-500 transition-colors line-clamp-2">
      {title}
    </h3>

    <p class="text-sm text-gray-500 line-clamp-2">
      {excerpt}
    </p>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
