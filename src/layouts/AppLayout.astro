---
import BaseLayout from './BaseLayout.astro';

interface PricingPlan {
  plan: string;
  price: string;
  features: string[];
}

interface Step {
  title: string;
  description: string;
}

interface Feature {
  title: string;
  description: string;
}

interface Props {
  name: string;
  slug: string;
  tagline: string;
  appStoreUrl: string;
  icon: string;
  category: string;
  status: 'live' | 'coming-soon';
  color: string;
  problem: string;
  steps: Step[];
  features: Feature[];
  pricing: PricingPlan[];
}

const {
  name,
  slug,
  tagline,
  appStoreUrl,
  icon,
  category,
  status,
  color,
  problem,
  steps,
  features,
  pricing,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: pricing.map((plan) => ({
    '@type': 'Offer',
    name: plan.plan,
    price: plan.price.replace('$', '').replace('/mo', ''),
    priceCurrency: 'USD',
  })),
};

const stepIcons = [
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />',
];

const featureIcons = [
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />',
];
---

<BaseLayout
  title={`${name} - ${tagline} | Loomic`}
  description={tagline}
  schema={schema}
>
  <!-- Hero -->
  <section class="section-padding bg-gradient-to-b from-gray-50 to-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <div
          class="inline-flex items-center justify-center w-20 h-20 rounded-2xl text-white text-3xl font-bold mb-6"
          style={`background-color: ${color}`}
        >
          {name.charAt(0)}
        </div>

        <div class="flex items-center justify-center gap-3 mb-4">
          <span class="text-sm font-medium text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
            {category}
          </span>
          {status === 'coming-soon' && (
            <span class="text-sm font-medium text-amber-600 bg-amber-50 px-3 py-1 rounded-full">
              Coming Soon
            </span>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {name}
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 mb-8">
          {tagline}
        </p>

        {status === 'live' ? (
          <a href={appStoreUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
            Install on Shopify
            <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ) : (
          <button class="btn-secondary cursor-not-allowed opacity-75" disabled>
            Coming Soon
          </button>
        )}
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 text-center">
          The Problem
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed text-center">
          {problem}
        </p>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-12 text-center">
        How It Works
      </h2>

      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {steps.map((step, index) => (
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white border-2 border-gray-200 mb-4">
              <svg class="w-8 h-8 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={stepIcons[index] || stepIcons[0]} />
            </div>
            <div class="text-sm font-medium text-gray-400 mb-2">Step {index + 1}</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-gray-600">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section-padding">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-12 text-center">
        Features
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {features.map((feature, index) => (
          <div class="p-6 bg-white rounded-xl border border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-200">
            <div
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg text-white mb-4"
              style={`background-color: ${color}`}
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={featureIcons[index % featureIcons.length]} />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{feature.title}</h3>
            <p class="text-gray-600 text-sm">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">
        Simple, Transparent Pricing
      </h2>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">
        Choose the plan that fits your store. All plans include full access to the dashboard.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {pricing.map((plan, index) => (
          <div class:list={[
            "p-6 bg-white rounded-xl border-2 transition-all duration-200",
            index === pricing.length - 1 ? "border-primary-500 shadow-lg" : "border-gray-100 hover:border-gray-200"
          ]}>
            {index === pricing.length - 1 && (
              <div class="text-xs font-semibold text-primary-500 mb-2">MOST POPULAR</div>
            )}
            <h3 class="text-lg font-semibold text-gray-900 mb-1">{plan.plan}</h3>
            <div class="text-3xl font-bold text-gray-900 mb-4">{plan.price}</div>
            <ul class="space-y-2">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-gradient-to-r from-primary-500 to-secondary-500">
    <div class="container-custom text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Ready to try {name}?
      </h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        {status === 'live'
          ? `Start your free trial today. No credit card required.`
          : `Be the first to know when ${name} launches.`}
      </p>

      {status === 'live' ? (
        <a
          href={appStoreUrl}
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold bg-white text-gray-900 rounded-lg transition-all duration-200 hover:bg-gray-100"
          target="_blank"
          rel="noopener noreferrer"
        >
          Install Free on Shopify
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold bg-white text-gray-900 rounded-lg transition-all duration-200 hover:bg-gray-100">
          Get Notified
        </a>
      )}
    </div>
  </section>
</BaseLayout>
