---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  appName: string;
  lastUpdated: string;
}

const { title, appName, lastUpdated } = Astro.props;
---

<BaseLayout
  title={title}
  description={`Privacy Policy for ${appName} by Loomic`}
  noindex={true}
>
  <section class="legal-content">
    <div class="legal-container">
      <div class="legal-header">
        <span class="app-badge">{appName}</span>
        <h1>Privacy Policy</h1>
        <p class="last-updated">Last updated: {lastUpdated}</p>
      </div>

      <div class="legal-body">
        <slot />

        <div class="contact-card">
          <h3>Loomic</h3>
          <p>Email: <a href="mailto:privacy@loomic.com">privacy@loomic.com</a></p>
          <p>Web: <a href="https://loomic.com">loomic.com</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-content {
    padding: 4rem 0 6rem;
  }

  .legal-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .legal-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .app-badge {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    background: #f3f4f6;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .legal-header h1 {
    font-family: var(--font-display), ui-serif, Georgia, serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .last-updated {
    color: #6b7280;
    font-size: 0.875rem;
  }

  .legal-body :global(h2) {
    font-family: var(--font-display), ui-serif, Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .legal-body :global(p) {
    color: #374151;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .legal-body :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .legal-body :global(li) {
    color: #374151;
    line-height: 1.75;
    margin-bottom: 0.5rem;
  }

  .legal-body :global(a) {
    color: #EC6161;
  }

  .legal-body :global(a:hover) {
    color: #d94f4f;
  }

  .legal-body :global(.highlight-box) {
    background: linear-gradient(135deg, #fef3f3 0%, #fdf8e8 100%);
    border-left: 3px solid #EC6161;
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    margin: 1.5rem 0;
  }

  .legal-body :global(.highlight-box p) {
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .contact-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 2rem;
    margin-top: 3rem;
  }

  .contact-card h3 {
    font-family: var(--font-display), ui-serif, Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.75rem;
  }

  .contact-card p {
    font-size: 0.95rem;
    color: #374151;
    margin-bottom: 0.5rem;
  }

  .contact-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .legal-content {
      padding: 2rem 0 4rem;
    }

    .legal-header h1 {
      font-size: 2rem;
    }

    .legal-body :global(h2) {
      font-size: 1.25rem;
    }
  }
</style>
