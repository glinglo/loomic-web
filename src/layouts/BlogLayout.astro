---
import BaseLayout from './BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import apps from '../data/apps.json';

interface Props {
  title: string;
  date: Date;
  category: string;
  excerpt: string;
  image?: string;
  relatedApp?: string;
}

const { title, date, category, excerpt, image, relatedApp } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate reading time from content
const content = await Astro.slots.render('default');
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (same category)
const allPosts = await getCollection('blog');
const currentSlug = Astro.url.pathname.split('/').pop();
const relatedPosts = allPosts
  .filter((post) => post.data.category === category && post.id !== currentSlug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Get related app info
const relatedAppData = relatedApp ? apps.find((a) => a.slug === relatedApp) : null;

const categoryColors: Record<string, string> = {
  'Customer Retention': 'bg-rose-50 text-rose-600',
  'Profitability': 'bg-emerald-50 text-emerald-600',
  'Shopify Tips': 'bg-blue-50 text-blue-600',
  'DTC Strategy': 'bg-purple-50 text-purple-600',
};

const categoryColor = categoryColors[category] || 'bg-gray-100 text-gray-600';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  image: image ? new URL(image, Astro.site).toString() : undefined,
  datePublished: date.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Loomic Team',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Loomic',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).toString(),
    },
  },
};
---

<BaseLayout
  title={`${title} | Loomic Blog`}
  description={excerpt}
  image={image}
  type="article"
  publishedTime={date.toISOString()}
  author="Loomic Team"
  schema={schema}
>
  <article>
    <!-- Header -->
    <header class="section-padding bg-gradient-to-b from-gray-50 to-white">
      <div class="container-custom">
        <div class="prose-custom">
          <div class="flex items-center gap-3 mb-6">
            <a href="/blog" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
              ← Back to Blog
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class={`text-sm font-medium px-3 py-1 rounded-full ${categoryColor}`}>
              {category}
            </span>
            <span class="text-sm text-gray-400">{formattedDate}</span>
            <span class="text-gray-300">·</span>
            <span class="text-sm text-gray-400">{readingTime} min read</span>
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight">
            {title}
          </h1>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 flex items-center justify-center text-white font-bold text-sm">
              L
            </div>
            <div>
              <div class="text-sm font-medium text-gray-900">Loomic Team</div>
              <div class="text-xs text-gray-500">Shopify App Developers</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    {image && (
      <div class="container-custom -mt-8 mb-12">
        <div class="prose-custom">
          <img
            src={image}
            alt={title}
            class="w-full rounded-xl shadow-lg"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="container-custom pb-16">
      <div class="prose-custom">
        <slot />
      </div>
    </div>

    <!-- Related App CTA -->
    {relatedAppData && (
      <section class="section-padding bg-gray-50">
        <div class="container-custom">
          <div class="prose-custom">
            <div class="p-6 md:p-8 bg-white rounded-xl border border-gray-100 shadow-sm">
              <div class="flex items-start gap-4">
                <div
                  class="w-14 h-14 rounded-xl flex items-center justify-center text-white text-2xl font-bold shrink-0"
                  style={`background-color: ${relatedAppData.color}`}
                >
                  {relatedAppData.name.charAt(0)}
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-gray-900 mb-2">
                    Try {relatedAppData.name}
                  </h3>
                  <p class="text-gray-600 mb-4">
                    {relatedAppData.tagline}
                  </p>
                  <a
                    href={`/${relatedAppData.slug}`}
                    class="inline-flex items-center text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors"
                  >
                    Learn more about {relatedAppData.name}
                    <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="section-padding">
        <div class="container-custom">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Related Posts</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                slug={post.id}
                date={post.data.date}
                category={post.data.category}
                excerpt={post.data.excerpt}
                image={post.data.image}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
